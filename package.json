{
  "name": "aemeath-ai-agent",
  "productName": "Aemeath",
  "version": "0.1.0",
  "description": "Aemeath desktop pet that walks on your desktop, reacts to your activity, and watches running AI sessions.",
  "main": "main.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "node scripts/verify.js && npm test",
    "package:linux": "electron-packager . Aemeath --platform=linux --arch=x64 --out=dist --overwrite --executable-name=aemeath --ignore=\"^/(tests|docs|\\.git)\"",
    "build": "npm run package:linux"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}
